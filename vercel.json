{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!_vercel/).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{views/**,seed-guides.js,og.js,assets/**,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    }
  }
}
