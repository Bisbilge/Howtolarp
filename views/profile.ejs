<%- include('partials/head') %>
<% if (profile.banned) { %>
  <div class="notice notice-warn" role="status"><b>Bu hesap engelli.</b> Sadece yöneticiler görebilir.</div>
<% } %>
<section class="profile">
  <div class="profile-id">
    <div class="avatar" aria-hidden="true"><%= profile.username[0].toUpperCase() %></div>
    <div>
      <p class="kicker">Larpçı dosyası</p>
      <h1 class="page-h handle">@<%= profile.username %></h1>
      <% if (profile.bio) { %><p class="bio"><%= profile.bio %></p><% } %>
    </div>
  </div>
  <dl class="stats">
    <div><dt>Rehber</dt><dd><%= guides.length %></dd></div>
    <div><dt>Larplanma</dt><dd><%= likesReceived %></dd></div>
    <div><dt>Üyelik</dt><dd class="stats-date"><%= formatDate(profile.created_at) %></dd></div>
  </dl>
  <% if (isMe) { %>
    <details class="bio-edit">
      <summary>Profil yazını düzenle</summary>
      <form method="post" action="/profil" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <textarea name="bio" maxlength="280" rows="3" placeholder="Hangi rolleri larplıyorsun?"><%= profile.bio %></textarea>
        <div class="f-actions"><button class="big-btn small" type="submit">Kaydet</button></div>
      </form>
    </details>
  <% } %>
</section>
<section class="index">
  <h2 class="index-title">Yazdığı rehberler</h2>
  <% if (guides.length) { %>
    <ol class="rows"><% guides.forEach((g, i) => { %><%- include('partials/row', { g, n: i + 1 }) %><% }) %></ol>
  <% } else { %>
    <div class="void">
      <p class="void-big">Boş dosya.</p>
      <p><%= isMe ? 'Henüz rehber yazmadın.' : 'Bu larpçı henüz rehber yazmamış.' %></p>
      <% if (isMe) { %><a class="big-btn" href="/yaz">İlk rehberini yaz →</a><% } %>
    </div>
  <% } %>
</section>
<%- include('partials/foot') %>
