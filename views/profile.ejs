<%- include('partials/head') %>
<section class="wrap">
  <header class="profile-head">
    <div class="avatar" aria-hidden="true"><%= profile.username[0].toUpperCase() %></div>
    <div>
      <h1 class="page-title">@<%= profile.username %></h1>
      <p class="muted"><%= guides.length %> rehber · rehberleri <%= likesReceived %> kez larplandı · <%= formatDate(profile.created_at) %> tarihinden beri üye</p>
      <% if (profile.bio) { %><p class="bio"><%= profile.bio %></p><% } %>
    </div>
  </header>

  <% if (isMe) { %>
    <details class="bio-edit">
      <summary>Profil yazını düzenle</summary>
      <form method="post" action="/profil" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <textarea name="bio" maxlength="280" rows="3" placeholder="Hangi rolleri larplıyorsun?"><%= profile.bio %></textarea>
        <button class="btn btn-sm" type="submit">Kaydet</button>
      </form>
    </details>
  <% } %>

  <% if (guides.length) { %>
    <div class="grid"><% guides.forEach(g => { %><%- include('partials/card', { g }) %><% }) %></div>
  <% } else { %>
    <div class="empty">
      <p><%= isMe ? 'Henüz rehber yazmadın.' : 'Bu larpçı henüz rehber yazmamış.' %></p>
      <% if (isMe) { %><a class="btn btn-accent" href="/yaz">İlk rehberini yaz</a><% } %>
    </div>
  <% } %>
</section>
<%- include('partials/foot') %>
