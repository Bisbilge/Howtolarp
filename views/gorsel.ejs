<%- include('partials/head') %>
<% const lines2 = (t) => String(t || '').split('\n').map(s => s.trim()).filter(Boolean);
   const phrases = guide ? lines2(guide.phrases).slice(0, format === 'story' ? 3 : 2).map(l => l.replace(/^["“”']+|["“”']+$/g, '')) : []; %>
<section class="ig-page">
  <div class="ig-controls">
    <p class="kicker">Sahne arkası · <a href="/yonetim">Yönetim</a></p>
    <h1 class="page-h">Görsel oluştur</h1>
    <form method="get" action="/yonetim/gorsel" class="form ig-form">
      <% if (guide) { %><input type="hidden" name="rehber" value="<%= guide.slug %>"><% } %>
      <div class="f">
        <span class="f-l">Rehber <em><%= list.length %> rehber</em></span>
        <div class="search ig-search">
          <input type="search" name="q" id="ig-q" value="<%= q %>" placeholder="İsim yaz: kahve, star wars…" autocomplete="off" aria-label="Rehber ara">
          <button type="submit">Ara</button>
        </div>
        <ul class="ig-list" id="ig-list">
          <% list.forEach(g => { %>
            <li data-key="<%= g.key %>"><a class="<%= guide && guide.slug === g.slug ? 'on' : '' %>" href="/yonetim/gorsel?rehber=<%= g.slug %>&format=<%= format %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">
              <span><%= persona(g.title) %></span><small><%= g.category %> · <%= formatDate(g.created_at) %></small></a></li>
          <% }) %>
          <li class="ig-none" id="ig-none" <%- list.length ? 'hidden' : '' %>>Eşleşen rehber yok.</li>
        </ul>
      </div>
      <% if (guide) { %><p class="ig-current">Seçili: <b><%= guide.title %></b> · <a href="/rehber/<%= guide.slug %>">Rehbere git</a></p><% } %>
      <div class="ig-formats">
        <label class="radio"><input type="radio" name="format" value="post" <%= format === 'post' ? 'checked' : '' %> onchange="this.form.submit()"><span>Instagram gönderi (1080×1350)</span></label>
        <label class="radio"><input type="radio" name="format" value="story" <%= format === 'story' ? 'checked' : '' %> onchange="this.form.submit()"><span>Instagram hikaye (1080×1920)</span></label>
        <label class="radio"><input type="radio" name="format" value="x" <%= format === 'x' ? 'checked' : '' %> onchange="this.form.submit()"><span>Twitter / X (1600×900)</span></label>
      </div>
    </form>
    <% if (guide) { %>
      <div class="f-actions">
        <button class="big-btn" type="button" id="ig-download">PNG indir ↓</button>
      </div>
      <p class="ig-caption-h f-l"><%= format === 'x' ? 'Önerilen tweet' : 'Önerilen açıklama' %></p>
      <% const link = baseUrl + '/rehber/' + guide.slug;
         const caption = format === 'x'
           ? ('Yeni rehber: ' + guide.title + '\n\n' + (guide.summary.length > 150 ? guide.summary.slice(0, 147).trim() + '…' : guide.summary) + '\n\n' + link)
           : ('Yeni rehber: ' + guide.title + '\n\n' + guide.summary + '\n\nRehberin tamamı ve daha fazlası: howtolarp.org (link profilde)\n\n#howtolarp #larp #mizah'); %>
      <textarea class="ig-caption" id="ig-caption" rows="7" readonly><%= caption %></textarea>
      <button class="ghost-btn" type="button" id="ig-copy">Metni kopyala</button>
    <% } %>
  </div>

  <% if (guide) { %>
  <div class="ig-stage" data-format="<%= format %>">
    <div class="ig-scale">
      <div class="ig ig-<%= format %>" id="ig-card">
        <div class="ig-top"><b>Yeni rehber</b><span>HOW TO LARP ✕ HOW TO LARP ✕ HOW TO LARP ✕ HOW TO LARP</span></div>
        <div class="ig-body">
          <div class="ig-main">
          <p class="ig-kicker"><%= guide.category %> · Zorluk <%= guide.difficulty %>/5 · <%= DIFFICULTY_LABELS[guide.difficulty] %></p>
          <h2 class="ig-persona" id="ig-persona"><%= persona(guide.title) %></h2>
          <p class="ig-line"><s>olma.</s> <mark>öyle görün.</mark></p>
          <p class="ig-sum"><%= guide.summary %></p>
          </div>
          <div class="ig-bubbles">
            <% phrases.forEach(p => { %><p class="ig-bubble"><%= p %></p><% }) %>
          </div>
        </div>
        <div class="ig-foot">
          <div class="ig-cta">Rehberin tamamı<br><b>howtolarp.org</b></div>
          <div class="ig-mark">HOW TO <span>LARP</span></div>
        </div>
        <div class="ig-sticker"><span>#<%= String(guide.id).padStart(3, '0') %></span></div>
      </div>
    </div>
  </div>
  <% } %>
</section>
<script src="/vendor/html-to-image.js"></script>
<script>
  // Yazdıkça filtrele (Türkçe karakter duyarsız)
  (function () {
    var input = document.getElementById('ig-q'), items = document.querySelectorAll('#ig-list li[data-key]');
    var none = document.getElementById('ig-none');
    var map = { 'ç': 'c', 'ğ': 'g', 'ı': 'i', 'ö': 'o', 'ş': 's', 'ü': 'u' };
    function fold(t) { return t.toLocaleLowerCase('tr').replace(/[çğıöşü]/g, function (c) { return map[c]; }).normalize('NFKD').replace(/[\u0300-\u036f]/g, ''); }
    function run() {
      var f = fold(input.value.trim()), shown = 0;
      items.forEach(function (li) { var ok = !f || li.dataset.key.indexOf(f) !== -1; li.hidden = !ok; if (ok) shown++; });
      none.hidden = shown > 0;
    }
    input.addEventListener('input', run);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { var first = document.querySelector('#ig-list li[data-key]:not([hidden]) a'); if (first) { e.preventDefault(); location.href = first.href; } }
    });
    var cur = document.querySelector('#ig-list a.on'); if (cur) cur.scrollIntoView({ block: 'nearest' });
  })();
  (function () {
    var card = document.getElementById('ig-card');
    if (!card) return;
    var stage = document.querySelector('.ig-stage'), scaleEl = document.querySelector('.ig-scale');
    var W = card.offsetWidth, H = card.offsetHeight;
    function fit() {
      var s = Math.min(1, stage.clientWidth / W);
      scaleEl.style.transform = 'scale(' + s + ')';
      stage.style.height = (H * s) + 'px';
    }
    // Uzun rol adlarını sığacak kadar küçült
    // Uzun rol adı ya da içerik kartı taşırırsa: önce başlığı küçült, yetmezse replik eksilt
    function fitPersona() {
      var p = document.getElementById('ig-persona'), body = card.querySelector('.ig-body'), size = card.classList.contains('ig-x') ? 190 : 230;
      // En fazla 3 satırlık başlık; kart taşmasın
      function wide() { return p.scrollWidth > p.clientWidth || p.offsetHeight > size * 3.9; }
      function overflow() { return body.scrollHeight > body.clientHeight + 1; }
      function shrink() { size -= 6; p.style.fontSize = size + 'px'; }
      p.style.fontSize = size + 'px';
      while ((wide() || overflow()) && size > (card.classList.contains('ig-x') ? 100 : 120)) shrink();
      var bubbles = Array.prototype.slice.call(card.querySelectorAll('.ig-bubble'));
      while (overflow() && bubbles.length > 1) bubbles.pop().remove();
      while ((wide() || overflow()) && size > 80) shrink();
      while (overflow() && bubbles.length) bubbles.pop().remove();
    }
    document.fonts.ready.then(function () { fitPersona(); H = card.offsetHeight; fit(); });
    window.addEventListener('resize', fit); fit();

    document.getElementById('ig-download').addEventListener('click', function () {
      var btn = this; btn.disabled = true; btn.textContent = 'Hazırlanıyor…';
      htmlToImage.toPng(card, { pixelRatio: 1, width: W, height: card.offsetHeight, cacheBust: true })
        .then(function (url) {
          var a = document.createElement('a');
          a.href = url; a.download = 'howtolarp-<%= guide ? guide.slug : "" %>-<%= format %>.png'; a.click();
        })
        .catch(function () { alert('Görsel oluşturulamadı. Sayfayı yenileyip tekrar dene.'); })
        .finally(function () { btn.disabled = false; btn.textContent = 'PNG indir ↓'; });
    });
    var copyBtn = document.getElementById('ig-copy');
    copyBtn.addEventListener('click', function () {
      var t = document.getElementById('ig-caption').value;
      (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject()).then(
        function () { copyBtn.textContent = 'Kopyalandı ✓'; },
        function () { document.getElementById('ig-caption').select(); });
    });
  })();
</script>
<%- include('partials/foot') %>
