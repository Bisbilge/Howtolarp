<%- include('partials/head') %>
<section class="page page-form">
  <aside class="page-side">
    <h1 class="page-h"><%= editing ? 'Rolü revize et' : 'Yeni rol yaz' %></h1>
    <p>Her satır ayrı bir madde olur. Kısa yaz, net yaz: okuyan kişi bu metinle sahneye çıkacak.</p>
    <p class="tip">İpucu: Başlığı "<b>X Nasıl Larplanır?</b>" diye bitirirsen rol kartında sadece "X" görünür.</p>
    <% if (!trusted) { %>
      <p class="tip tip-pink"><b>Onay:</b> İlk rehberlerin yöneticiler onayladıktan sonra yayına girer. Birkaç rehberin onaylanınca bu adım kalkar.</p>
    <% } %>
    <% if (typeof requested !== 'undefined' && requested.length && !editing) { %>
      <div class="tip tip-req"><b>Fikir mi lazım? En çok istenenler:</b>
        <ul><% requested.forEach(r => { %><li><a href="/yaz?baslik=<%= encodeURIComponent(r.text + ' Nasıl Larplanır?') %>"><%= r.text %></a> <span class="muted">▲<%= r.votes %></span></li><% }) %></ul>
      </div>
    <% } %>
    <p class="tip">Link ve web adresi paylaşılamaz. Gerçek kişileri hedef alma. <a href="/kurallar">Kurallar</a></p>
  </aside>
  <div class="page-main">
    <div class="draft-note" id="draft-note" hidden>
      <span>Kaydedilmemiş bir taslağın var (<span id="draft-time"></span>).</span>
      <button type="button" class="ghost-btn" id="draft-restore">Geri yükle</button>
      <button type="button" class="ghost-btn" id="draft-drop">Sil</button>
    </div>
    <% if (errors.length) { %>
      <div class="alert"><b>Sahneye çıkamazsın:</b><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
    <% } %>
    <form method="post" action="<%= editing ? '/rehber/' + editing.slug + '/duzenle' : '/yaz' %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="hp" aria-hidden="true"><label>Web sitesi <input name="website" tabindex="-1" autocomplete="off"></label></div>

      <label class="f"><span class="f-l">01 / Başlık</span>
        <input class="f-big" name="title" required minlength="5" maxlength="120" value="<%= g.title || '' %>" placeholder="Zeki Biri Gibi Nasıl Larplanır?">
      </label>

      <div class="f-pair">
        <label class="f"><span class="f-l">02 / Kategori</span>
          <select name="category" required>
            <option value="">Seç</option>
            <% CATEGORIES.forEach(c => { %><option <%= g.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
          </select>
        </label>
        <label class="f"><span class="f-l">03 / Larp zorluğu</span>
          <select name="difficulty" required>
            <% for (let i = 1; i <= 5; i++) { %><option value="<%= i %>" <%= Number(g.difficulty) === i ? 'selected' : '' %>><%= i %> · <%= DIFFICULTY_LABELS[i] %></option><% } %>
          </select>
        </label>
      </div>

      <label class="f"><span class="f-l">04 / Özet</span>
        <textarea name="summary" required minlength="20" maxlength="400" rows="3" placeholder="Bu rol kimin için, ana fikri ne?"><%= g.summary || '' %></textarea>
      </label>

      <label class="f"><span class="f-l">05 / Hazırlık <em>isteğe bağlı · eşya, bilgi, tavır</em></span>
        <textarea name="kit" rows="4" placeholder="Numarasız gözlük&#10;Kapağı yıpranmış bir kitap"><%= g.kit || '' %></textarea>
      </label>

      <label class="f"><span class="f-l">06 / Sahne talimatı <em>en az 2 satır</em></span>
        <textarea name="steps" required rows="7" placeholder="Bir soru sorulduğunda üç saniye bekle.&#10;Her konuyu 'sistem' kavramına bağla."><%= g.steps || '' %></textarea>
      </label>

      <label class="f"><span class="f-l">07 / Replikler <em>isteğe bağlı</em></span>
        <textarea name="phrases" rows="4" placeholder="Aslında mesele bu değil."><%= g.phrases || '' %></textarea>
      </label>

      <label class="f"><span class="f-l">08 / Nerede yakalanırsın <em>isteğe bağlı</em></span>
        <textarea name="risks" rows="4" placeholder="Gerçek bir uzmanla aynı masaya düşmek."><%= g.risks || '' %></textarea>
      </label>

      <div class="f-actions">
        <button class="big-btn" type="submit"><%= editing ? 'Kaydet →' : (trusted ? 'Yayınla →' : 'Onaya gönder →') %></button>
        <a href="<%= editing ? '/rehber/' + editing.slug : '/' %>">Vazgeç</a>
      </div>
    </form>
  </div>
</section>
<script>
  // Taslak: form yazdıkça bu tarayıcıya kaydedilir; sayfa kapanırsa geri yüklenebilir.
  (function () {
    var form = document.querySelector('.form');
    if (!form) return;
    var KEY = 'howtolarp-taslak:<%= editing ? editing.slug : "yeni" %>';
    var FIELDS = ['title', 'category', 'difficulty', 'summary', 'kit', 'steps', 'phrases', 'risks'];
    function read() { var o = {}; FIELDS.forEach(function (n) { var el = form.elements[n]; if (el) o[n] = el.value; }); return o; }
    function same(a, b) { return FIELDS.every(function (n) { return String(a[n] || '') === String(b[n] || ''); }); }
    function load() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; } }
    function drop() { try { localStorage.removeItem(KEY); } catch (e) {} }
    var initial = read(), saved = load(), t;

    // Sayfadaki halden farklı bir taslak varsa sor (üzerine kendiliğinden yazma)
    if (saved && saved.data && !same(saved.data, initial)) {
      var note = document.getElementById('draft-note');
      document.getElementById('draft-time').textContent = new Date(saved.at).toLocaleString('tr-TR', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
      note.hidden = false;
      document.getElementById('draft-restore').onclick = function () {
        FIELDS.forEach(function (n) { var el = form.elements[n]; if (el && saved.data[n] != null) el.value = saved.data[n]; });
        note.hidden = true;
      };
      document.getElementById('draft-drop').onclick = function () { drop(); note.hidden = true; };
    }
    form.addEventListener('input', function () {
      clearTimeout(t);
      t = setTimeout(function () {
        var now = read();
        try { if (same(now, initial)) drop(); else localStorage.setItem(KEY, JSON.stringify({ at: Date.now(), data: now })); } catch (e) {}
      }, 400);
    });
    form.addEventListener('submit', drop);
  })();
</script>
<%- include('partials/foot') %>
