<%- include('partials/head') %>
<section class="page page-form">
  <aside class="page-side">
    <h1 class="page-h"><%= editing ? 'Rolü revize et' : 'Yeni rol yaz' %></h1>
    <p>Her kutu ayrı bir madde olur; yenisi için "+ Madde ekle"ye bas ya da Enter'a bas. Kısa yaz, net yaz: okuyan kişi bu metinle sahneye çıkacak.</p>
    <p class="tip">İpucu: Başlığı "<b>X Nasıl Larplanır?</b>" diye bitirirsen rol kartında sadece "X" görünür.</p>
    <% if (!trusted) { %>
      <p class="tip tip-pink"><b>Onay:</b> İlk rehberlerin yöneticiler onayladıktan sonra yayına girer. Birkaç rehberin onaylanınca bu adım kalkar.</p>
    <% } %>
    <% if (typeof requested !== 'undefined' && requested.length && !editing) { %>
      <div class="tip tip-req"><b>Fikir mi lazım? En çok istenenler:</b>
        <ul><% requested.forEach(r => { %><li><a href="/yaz?baslik=<%= encodeURIComponent(r.text + ' Nasıl Larplanır?') %>"><%= r.text %></a> <span class="muted">▲<%= r.votes %></span></li><% }) %></ul>
      </div>
    <% } %>
    <p class="tip">Link ve web adresi paylaşılamaz. Gerçek kişileri hedef alma. <a href="/kurallar">Kurallar</a></p>
  </aside>
  <div class="page-main">
    <div class="draft-note" id="draft-note" hidden>
      <span>Kaydedilmemiş bir taslağın var (<span id="draft-time"></span>).</span>
      <button type="button" class="ghost-btn" id="draft-restore">Geri yükle</button>
      <button type="button" class="ghost-btn" id="draft-drop">Sil</button>
    </div>
    <% if (errors.length) { %>
      <div class="alert"><b>Sahneye çıkamazsın:</b><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
    <% } %>
    <form method="post" action="<%= editing ? '/rehber/' + editing.slug + '/duzenle' : '/yaz' %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="hp" aria-hidden="true"><label>Web sitesi <input name="website" tabindex="-1" autocomplete="off"></label></div>

      <label class="f"><span class="f-l">01 / Başlık</span>
        <input class="f-big" name="title" required minlength="5" maxlength="120" value="<%= g.title || '' %>" placeholder="Zeki Biri Gibi Nasıl Larplanır?">
      </label>

      <div class="f-pair">
        <label class="f"><span class="f-l">02 / Kategori</span>
          <select name="category" required>
            <option value="">Seç</option>
            <% CATEGORIES.forEach(c => { %><option <%= g.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
          </select>
        </label>
        <label class="f"><span class="f-l">03 / Larp zorluğu</span>
          <select name="difficulty" required>
            <% for (let i = 1; i <= 5; i++) { %><option value="<%= i %>" <%= Number(g.difficulty) === i ? 'selected' : '' %>><%= i %> · <%= DIFFICULTY_LABELS[i] %></option><% } %>
          </select>
        </label>
      </div>

      <label class="f"><span class="f-l">04 / Özet</span>
        <textarea name="summary" required minlength="20" maxlength="400" rows="3" placeholder="Bu rol kimin için, ana fikri ne?"><%= g.summary || '' %></textarea>
      </label>

      <div class="f"><span class="f-l" id="l-kit">05 / Hazırlık <em>isteğe bağlı · eşya, bilgi, tavır</em></span>
        <textarea name="kit" rows="4" aria-labelledby="l-kit" data-items="1" data-hints="Numarasız gözlük|Kapağı yıpranmış bir kitap" placeholder="Numarasız gözlük&#10;Kapağı yıpranmış bir kitap"><%= g.kit || '' %></textarea>
      </div>

      <div class="f"><span class="f-l" id="l-steps">06 / Sahne talimatı <em>en az 2 madde</em></span>
        <textarea name="steps" required rows="7" aria-labelledby="l-steps" data-items="2" data-hints="Bir soru sorulduğunda üç saniye bekle.|Her konuyu 'sistem' kavramına bağla.|Bir sonraki adım…" placeholder="Bir soru sorulduğunda üç saniye bekle.&#10;Her konuyu 'sistem' kavramına bağla."><%= g.steps || '' %></textarea>
      </div>

      <div class="f"><span class="f-l" id="l-phrases">07 / Replikler <em>isteğe bağlı · söyleyeceğin cümleler</em></span>
        <textarea name="phrases" rows="4" aria-labelledby="l-phrases" data-items="1" data-hints="Aslında mesele bu değil.|Bunu ilk kim söyledi, biliyor musun?" placeholder="Aslında mesele bu değil."><%= g.phrases || '' %></textarea>
      </div>

      <div class="f"><span class="f-l" id="l-risks">08 / Nerede yakalanırsın <em>isteğe bağlı</em></span>
        <textarea name="risks" rows="4" aria-labelledby="l-risks" data-items="1" data-hints="Gerçek bir uzmanla aynı masaya düşmek." placeholder="Gerçek bir uzmanla aynı masaya düşmek."><%= g.risks || '' %></textarea>
      </div>

      <div class="f-actions">
        <button class="big-btn" type="submit"><%= editing ? 'Kaydet →' : (trusted ? 'Yayınla →' : 'Onaya gönder →') %></button>
        <a href="<%= editing ? '/rehber/' + editing.slug : '/' %>">Vazgeç</a>
      </div>
    </form>
  </div>
</section>
<script>
  // Madde madde alanlar: her madde ayrı kutu. Asıl veri gizli textarea'da satır satır durur (JS yoksa textarea görünür).
  (function () {
    document.querySelectorAll('textarea[data-items]').forEach(function (ta) {
      var min = Number(ta.dataset.items) || 1, hints = (ta.dataset.hints || '').split('|');
      var box = document.createElement('div'); box.className = 'items';
      var list = document.createElement('ol'); list.className = 'items-list';
      var add = document.createElement('button'); add.type = 'button'; add.className = 'items-add'; add.textContent = '+ Madde ekle';
      box.appendChild(list); box.appendChild(add);
      ta.hidden = true; ta.required = false; ta.parentNode.insertBefore(box, ta.nextSibling);
      var label = document.getElementById(ta.getAttribute('aria-labelledby'));

      function grow(el) { el.style.height = 'auto'; el.style.height = el.scrollHeight + 'px'; }
      function sync() {
        ta.value = Array.prototype.map.call(list.querySelectorAll('.items-in'), function (i) { return i.value.replace(/\s*\n\s*/g, ' ').trim(); })
          .filter(Boolean).join('\n');
        ta.dispatchEvent(new Event('input', { bubbles: true }));
      }
      function renumber() {
        Array.prototype.forEach.call(list.children, function (li, i) {
          var inp = li.querySelector('.items-in');
          inp.placeholder = hints[Math.min(i, hints.length - 1)] || '';
          inp.setAttribute('aria-label', (label ? label.firstChild.textContent.trim() : 'Madde') + ' · madde ' + (i + 1));
        });
      }
      function row(value, after) {
        var li = document.createElement('li');
        var inp = document.createElement('textarea'); inp.className = 'items-in'; inp.rows = 1; inp.maxLength = 300; inp.value = value || '';
        var del = document.createElement('button'); del.type = 'button'; del.className = 'items-del'; del.textContent = '×'; del.title = 'Maddeyi sil'; del.setAttribute('aria-label', 'Maddeyi sil');
        li.appendChild(inp); li.appendChild(del);
        if (after && after.nextSibling) list.insertBefore(li, after.nextSibling); else list.appendChild(li);
        inp.addEventListener('input', function () {
          // Birden fazla satır yapıştırıldıysa her satırı ayrı maddeye böl
          if (inp.value.indexOf('\n') !== -1) {
            var parts = inp.value.split(/\n+/).map(function (s) { return s.trim(); }).filter(Boolean);
            inp.value = parts.shift() || '';
            var last = li;
            parts.forEach(function (p) { last = row(p, last); });
            renumber(); last.querySelector('.items-in').focus();
          }
          grow(inp); sync();
        });
        inp.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            var n = row('', li); renumber(); n.querySelector('.items-in').focus();
          } else if (e.key === 'Backspace' && !inp.value && list.children.length > min) {
            e.preventDefault();
            var prev = li.previousElementSibling; li.remove(); renumber(); sync();
            if (prev) { var p = prev.querySelector('.items-in'); p.focus(); p.setSelectionRange(p.value.length, p.value.length); }
          }
        });
        del.addEventListener('click', function () {
          if (list.children.length > min) li.remove(); else inp.value = '';
          renumber(); sync();
        });
        setTimeout(function () { grow(inp); }, 0);
        return li;
      }
      function build() {
        list.innerHTML = '';
        var items = ta.value.split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
        while (items.length < min) items.push('');
        items.forEach(function (v) { row(v); });
        renumber();
      }
      add.addEventListener('click', function () {
        var n = row(''); renumber(); n.querySelector('.items-in').focus();
      });
      ta.rebuildItems = build;
      build();
    });
  })();

  // Taslak: form yazdıkça bu tarayıcıya kaydedilir; sayfa kapanırsa geri yüklenebilir.
  (function () {
    var form = document.querySelector('.form');
    if (!form) return;
    var KEY = 'howtolarp-taslak:<%= editing ? editing.slug : "yeni" %>';
    var FIELDS = ['title', 'category', 'difficulty', 'summary', 'kit', 'steps', 'phrases', 'risks'];
    function read() { var o = {}; FIELDS.forEach(function (n) { var el = form.elements[n]; if (el) o[n] = el.value; }); return o; }
    function same(a, b) { return FIELDS.every(function (n) { return String(a[n] || '') === String(b[n] || ''); }); }
    function load() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; } }
    function drop() { try { localStorage.removeItem(KEY); } catch (e) {} }
    var initial = read(), saved = load(), t;

    // Sayfadaki halden farklı bir taslak varsa sor (üzerine kendiliğinden yazma)
    if (saved && saved.data && !same(saved.data, initial)) {
      var note = document.getElementById('draft-note');
      document.getElementById('draft-time').textContent = new Date(saved.at).toLocaleString('tr-TR', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
      note.hidden = false;
      document.getElementById('draft-restore').onclick = function () {
        FIELDS.forEach(function (n) { var el = form.elements[n]; if (el && saved.data[n] != null) { el.value = saved.data[n]; if (el.rebuildItems) el.rebuildItems(); } });
        note.hidden = true;
      };
      document.getElementById('draft-drop').onclick = function () { drop(); note.hidden = true; };
    }
    form.addEventListener('input', function () {
      clearTimeout(t);
      t = setTimeout(function () {
        var now = read();
        try { if (same(now, initial)) drop(); else localStorage.setItem(KEY, JSON.stringify({ at: Date.now(), data: now })); } catch (e) {}
      }, 400);
    });
    form.addEventListener('submit', function () {
      drop();
      // Çift basışta iki rehber açılmasın
      var btn = form.querySelector('.f-actions button[type=submit]');
      if (btn) setTimeout(function () { btn.disabled = true; btn.textContent = 'Gönderiliyor…'; }, 0);
    });
  })();
</script>
<%- include('partials/foot') %>
