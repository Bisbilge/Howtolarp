<%- include('partials/head') %>
<section class="wrap narrow">
  <h1 class="page-title"><%= editing ? 'Rehberi düzenle' : 'Yeni larp rehberi' %></h1>
  <p class="muted">Her satır bir madde olarak gösterilir. Kısa ve net yaz; okuyan kişi bu rehberle sahneye çıkacak.</p>

  <% if (errors.length) { %>
    <div class="alert"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
  <% } %>

  <form method="post" action="<%= editing ? '/rehber/' + editing.slug + '/duzenle' : '/yaz' %>" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <label>Başlık
      <input name="title" required minlength="5" maxlength="120" value="<%= g.title || '' %>" placeholder="Zeki Biri Gibi Nasıl Larplanır?">
    </label>

    <div class="row">
      <label>Kategori
        <select name="category" required>
          <option value="">Seç</option>
          <% CATEGORIES.forEach(c => { %><option <%= g.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </label>
      <label>Larp zorluğu
        <select name="difficulty" required>
          <% for (let i = 1; i <= 5; i++) { %><option value="<%= i %>" <%= Number(g.difficulty) === i ? 'selected' : '' %>><%= i %> · <%= DIFFICULTY_LABELS[i] %></option><% } %>
        </select>
      </label>
    </div>

    <label>Özet
      <textarea name="summary" required minlength="20" maxlength="400" rows="3" placeholder="Bu larp kimin için, ana fikri ne? Bir iki cümle."><%= g.summary || '' %></textarea>
    </label>

    <label>Gerekenler <span class="hint">İsteğe bağlı · her satır bir eşya ya da hazırlık</span>
      <textarea name="kit" rows="4" placeholder="Numarasız gözlük&#10;Kapağı yıpranmış bir kitap"><%= g.kit || '' %></textarea>
    </label>

    <label>Adımlar <span class="hint">En az 2 · her satır bir adım</span>
      <textarea name="steps" required rows="7" placeholder="Bir soru sorulduğunda üç saniye bekle.&#10;Her konuyu 'sistem' kavramına bağla."><%= g.steps || '' %></textarea>
    </label>

    <label>Söylenecek cümleler <span class="hint">İsteğe bağlı · her satır bir replik</span>
      <textarea name="phrases" rows="4" placeholder="Aslında mesele bu değil."><%= g.phrases || '' %></textarea>
    </label>

    <label>İfşa olma riskleri <span class="hint">İsteğe bağlı · nerede yakalanırsın?</span>
      <textarea name="risks" rows="4" placeholder="Gerçek bir uzmanla aynı masaya düşmek."><%= g.risks || '' %></textarea>
    </label>

    <div class="form-actions">
      <button class="btn btn-accent btn-lg" type="submit"><%= editing ? 'Kaydet' : 'Yayınla' %></button>
      <a class="btn" href="<%= editing ? '/rehber/' + editing.slug : '/' %>">Vazgeç</a>
    </div>
  </form>
</section>
<%- include('partials/foot') %>
