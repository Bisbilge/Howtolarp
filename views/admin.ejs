<%- include('partials/head') %>
<section class="admin">
  <p class="kicker">Sahne arkası · <%= user.isSuper ? 'Baş yönetici' : 'Editör' %></p>
  <h1 class="page-h">Yönetim</h1>
  <dl class="stats">
    <div><dt>Onay bekleyen</dt><dd><%= pending.length %></dd></div>
    <div><dt>Açık bildirim</dt><dd><%= reported.length %></dd></div>
    <div><dt>Rehber</dt><dd><%= totals.guides %></dd></div>
  </dl>
  <dl class="stats stats-members">
    <div><dt>Üye</dt><dd><%= totals.users %></dd></div>
    <div><dt>Bu hafta yeni</dt><dd><%= totals.users_week %></dd></div>
    <div><dt>Bugün yeni</dt><dd><%= totals.users_today %></dd></div>

  </dl>

  <form class="search adm-search" method="get" action="/yonetim">
    <input type="search" name="q" value="<%= q %>" placeholder="Rehber ara: başlık, kategori ya da yazar" aria-label="Rehber ara">
    <button type="submit">Ara</button>
  </form>
  <% if (found) { %>
    <h2 class="adm-h">Arama: “<%= q %>” <small class="muted"><%= found.length %> sonuç</small></h2>
    <% if (!found.length) { %><p class="adm-empty">Eşleşen rehber yok.</p><% } %>
    <ul class="adm-list">
      <% found.forEach(g => { %>
        <li>
          <div>
            <a href="/rehber/<%= g.slug %>"><%= g.title %></a>
            <span class="muted handle">@<%= g.username %></span>
            <% if (!g.approved) { %><span class="flag flag-wait">Onay bekliyor</span><% } %>
            <% if (g.hidden) { %><span class="flag">Gizli</span><% } %>
          </div>
          <span class="adm-list-actions">
            <a class="adm-btn" href="/rehber/<%= g.slug %>/duzenle">Düzenle</a>
            <% if (g.approved && !g.hidden) { %><a class="adm-btn" href="/yonetim/gorsel?rehber=<%= g.slug %>">Görsel</a><% } %>
          </span>
        </li>
      <% }) %>
    </ul>
    <p><a class="ghost-btn" href="/yonetim">Aramayı temizle</a></p>
  <% } %>
  <p class="adm-tools">
    <a class="ghost-btn" href="/yonetim/gorsel">Görsel oluştur (Instagram, <span lang="en">Twitter</span>) ↗</a>
    <a class="ghost-btn" href="/yonetim/gorsel/enler">En çok larplananlar / Günün larperi ↗</a>
    <a class="ghost-btn" href="/yonetim/gorsel/istatistik">Larp raporu (istatistik görseli) ↗</a>
    <% if (user.isSuper) { %><a class="ghost-btn" href="/yonetim/yedek" download>Yedek indir ↓</a><% } %>
  </p>
  <% if (user.isSuper) { %><p class="adm-note">Yedek dosyasında hesap bilgileri de var. Kimseyle paylaşma, haftada bir indir.</p><% } %>


  <h2 class="adm-h" id="paylasilacaklar">Paylaşılacaklar <small class="muted"><%= shares.length %> rehber</small></h2>
  <% if (!shares.length) { %>
    <p class="adm-empty">Paylaşılmayı bekleyen rehber yok. Yeni rehberler yayına girince buraya kendiliğinden düşer.</p>
  <% } %>
  <% shares.forEach(s => { %>
    <article class="case share">
      <header class="case-head">
        <div>
          <a class="case-title" href="/rehber/<%= s.slug %>"><%- markEn(s.title) %></a>
          <p class="case-meta"><%= s.category %> · sıraya girdi: <%= formatDate(s.queued_at) %></p>
        </div>
        <div class="case-actions"><form method="post" action="/yonetim/paylasim/<%= s.guide_id %>/atla" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="">Atla</button></form></div>
      </header>
      <div class="share-rows">
        <div class="share-row">
          <span class="share-pf"><span lang="en">Twitter</span> / X</span>
          <% if (s.x_at) { %><span class="share-done">✓ Paylaşıldı</span><% } else { %>
            <a class="adm-btn adm-btn-ok" href="<%= s.tweetUrl %>" target="_blank" rel="noopener">Tweet'i aç ↗</a>
            <form method="post" action="/yonetim/paylasim/<%= s.guide_id %>/x" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="">Paylaşıldı ✓</button></form>
          <% } %>
        </div>
        <div class="share-row">
          <span class="share-pf">Instagram</span>
          <% if (s.ig_at) { %><span class="share-done">✓ Paylaşıldı</span><% } else { %>
            <a class="adm-btn adm-btn-ok" href="/yonetim/gorsel?rehber=<%= s.slug %>&format=post">Görseli hazırla ↗</a>
            <form method="post" action="/yonetim/paylasim/<%= s.guide_id %>/ig" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="">Paylaşıldı ✓</button></form>
          <% } %>
        </div>
      </div>
    </article>
  <% }) %>

  <h2 class="adm-h">Onay bekleyenler</h2>
  <% if (!pending.length) { %>
    <p class="adm-empty">Onay bekleyen rehber yok.</p>
  <% } %>
  <% pending.forEach(g => { %>
    <article class="case case-wait">
      <header class="case-head">
        <div>
          <a class="case-title" href="/rehber/<%= g.slug %>"><%- markEn(g.title) %></a>
          <p class="case-meta">
            <span class="handle">@<%= g.username %></span> · <%= g.category %> · <%= formatDate(g.created_at) %>
            · onaylı rehberi: <b><%= g.author_approved %>/<%= TRUST_AFTER %></b>
          </p>
        </div>
        <div class="case-actions">
          <form method="post" action="/yonetim/rehber/<%= g.id %>/onayla" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ok">Onayla</button></form>
          <form method="post" action="/yonetim/rehber/<%= g.id %>/sil" class="inline" onsubmit="return confirm('Rehber reddedilip silinsin mi?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Reddet</button></form>
          <% if (canBan(g)) { %>
            <form method="post" action="/yonetim/kullanici/<%= g.user_id %>/engelle" class="inline" onsubmit="return confirm('@<%= g.username %> spam diye engellensin mi? Bekleyen tüm rehberleri silinir.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Spam, engelle</button></form>
          <% } %>
        </div>
      </header>
      <p class="case-sum"><%= g.summary %></p>
    </article>
  <% }) %>

  <h2 class="adm-h">Bildirilen rehberler</h2>
  <% if (!reported.length) { %>
    <p class="adm-empty">Bekleyen bildirim yok. Herkes rolünü düzgün oynuyor.</p>
  <% } %>
  <% reported.forEach(g => { %>
    <article class="case">
      <header class="case-head">
        <div>
          <a class="case-title" href="/rehber/<%= g.slug %>"><%- markEn(g.title) %></a>
          <p class="case-meta">
            <span class="handle">@<%= g.username %></span>
            · <b><%= g.report_count %></b> bildirim
            <% if (g.hidden) { %>· <span class="flag">Gizlendi</span><% } %>
          </p>
        </div>
        <div class="case-actions">
          <form method="post" action="/yonetim/rehber/<%= g.id %>/temiz" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Sorun yok, yayında kalsın</button></form>
          <form method="post" action="/yonetim/rehber/<%= g.id %>/gizle" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Gizle</button></form>
          <form method="post" action="/yonetim/rehber/<%= g.id %>/sil" class="inline" onsubmit="return confirm('Rehber kalıcı olarak silinsin mi?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Sil</button></form>
          <% if (canBan(g)) { %>
            <form method="post" action="/yonetim/kullanici/<%= g.user_id %>/engelle" class="inline" onsubmit="return confirm('@<%= g.username %> engellensin mi? Tüm rehberleri gizlenir ve oturumu kapanır.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Yazarı engelle</button></form>
          <% } %>
        </div>
      </header>
      <ul class="case-reports">
        <% g.reports.forEach(r => { %>
          <li>
            <span class="case-reason"><%= REPORT_REASONS[r.reason] || r.reason %></span>
            <span class="case-by"><span class="handle">@<%= r.username %></span> · <%= formatDate(r.created_at) %></span>
            <% if (r.note) { %><q><%= r.note %></q><% } %>
          </li>
        <% }) %>
      </ul>
    </article>
  <% }) %>

  <h2 class="adm-h">Gizli rehberler</h2>
  <% if (!hidden.length) { %><p class="adm-empty">Gizlenmiş rehber yok.</p><% } %>
  <ul class="adm-list">
    <% hidden.forEach(g => { %>
      <li>
        <a href="/rehber/<%= g.slug %>"><%= g.title %></a> <span class="handle muted">@<%= g.username %></span>
        <span class="adm-list-actions">
          <form method="post" action="/yonetim/rehber/<%= g.id %>/temiz" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Yayına al</button></form>
          <form method="post" action="/yonetim/rehber/<%= g.id %>/sil" class="inline" onsubmit="return confirm('Rehber kalıcı olarak silinsin mi?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Sil</button></form>
        </span>
      </li>
    <% }) %>
  </ul>

  <% if (user.isSuper) { %>
    <h2 class="adm-h" id="telegram">Telegram bildirimi</h2>
    <% if (tg.msg) { %><div class="notice-inline"><%= tg.msg %></div><% } %>
    <p class="adm-empty">
      Durum: <b><%= tg.token && tg.chat ? 'Açık ✓' : (tg.token ? 'Bot tanımlı, sohbet kimliği eksik' : 'Kapalı') %></b>.
      Onay bekleyen rehber, bildirim, yeni istek ve yeni editörde mesaj gelir.
    </p>
    <% if (tg.token) { %>
      <div class="share-row tg-row">
        <form method="post" action="/yonetim/telegram/bul" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Sohbet kimliğini bul</button></form>
        <% if (tg.chat) { %><form method="post" action="/yonetim/telegram/test" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Test mesajı gönder</button></form><% } %>
      </div>
    <% } %>
  <% } %>

  <h2 class="adm-h">Son üyeler <small class="muted"><a href="/yonetim/uyeler">Tüm üyeler (<%= totals.users %>) →</a></small></h2>
  <% if (!newestUsers.length) { %><p class="adm-empty">Henüz üye yok.</p><% } %>
  <ul class="adm-list members">
    <% newestUsers.forEach(u => { %>
      <li><div>
        <b class="handle">@<%= u.username %></b>
        <% if (isAdminName(u.username)) { %><span class="flag flag-wait">Baş yönetici</span><% } else if (u.role === 'editor') { %><span class="flag flag-wait">Editör</span><% } %>
        <% if (u.banned) { %><span class="flag">Engelli</span><% } %>
        <span class="muted member-meta"><%= formatDate(u.created_at) %> · <%= u.guide_count %> rehber</span>
      </div></li>
    <% }) %>
  </ul>

  <h2 class="adm-h">Editörler</h2>
  <% if (!editors.length) { %><p class="adm-empty">Henüz editör yok. Vercel'de ADMIN_SIGNUP_CODE tanımlayıp kodu editörlerine ver; kodla üye olan editör olur.</p><% } %>
  <ul class="adm-list">
    <% editors.forEach(u => { %>
      <li>
        <b class="handle">@<%= u.username %></b> <span class="muted">· <%= formatDate(u.created_at) %></span>
        <% if (user.isSuper) { %>
          <span class="adm-list-actions">
            <form method="post" action="/yonetim/kullanici/<%= u.id %>/yetki-al" class="inline" onsubmit="return confirm('@<%= u.username %> artık editör olmasın mı?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Yetkiyi al</button></form>
          </span>
        <% } %>
      </li>
    <% }) %>
  </ul>

  <h2 class="adm-h">Engelli kullanıcılar</h2>
  <% if (!banned.length) { %><p class="adm-empty">Engelli kullanıcı yok.</p><% } %>
  <ul class="adm-list">
    <% banned.forEach(u => { %>
      <li>
        <b class="handle">@<%= u.username %></b>
        <span class="adm-list-actions">
          <form method="post" action="/yonetim/kullanici/<%= u.id %>/kaldir" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Engeli kaldır</button></form>
        </span>
      </li>
    <% }) %>
  </ul>
</section>
<%- include('partials/foot') %>
