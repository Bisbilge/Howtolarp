<%- include('partials/head') %>
<section class="admin">
  <p class="kicker">Sahne arkası · <%= user.isSuper ? 'Baş yönetici' : 'Editör' %></p>
  <h1 class="page-h">Yönetim</h1>
  <dl class="stats">
    <div><dt>Onay bekleyen</dt><dd><%= pending.length %></dd></div>
    <div><dt>Açık bildirim</dt><dd><%= reported.length %></dd></div>
    <div><dt>Rehber</dt><dd><%= totals.guides %></dd></div>

  </dl>

  <h2 class="adm-h">Onay bekleyenler</h2>
  <% if (!pending.length) { %>
    <p class="adm-empty">Onay bekleyen rehber yok.</p>
  <% } %>
  <% pending.forEach(g => { %>
    <article class="case case-wait">
      <header class="case-head">
        <div>
          <a class="case-title" href="/rehber/<%= g.slug %>"><%= g.title %></a>
          <p class="case-meta">
            <span class="handle">@<%= g.username %></span> · <%= g.category %> · <%= formatDate(g.created_at) %>
            · onaylı rehberi: <b><%= g.author_approved %>/<%= TRUST_AFTER %></b>
          </p>
        </div>
        <div class="case-actions">
          <form method="post" action="/yonetim/rehber/<%= g.id %>/onayla" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ok">Onayla</button></form>
          <form method="post" action="/yonetim/rehber/<%= g.id %>/sil" class="inline" onsubmit="return confirm('Rehber reddedilip silinsin mi?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Reddet</button></form>
          <% if (canBan(g)) { %>
            <form method="post" action="/yonetim/kullanici/<%= g.user_id %>/engelle" class="inline" onsubmit="return confirm('@<%= g.username %> spam diye engellensin mi? Bekleyen tüm rehberleri silinir.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Spam, engelle</button></form>
          <% } %>
        </div>
      </header>
      <p class="case-sum"><%= g.summary %></p>
    </article>
  <% }) %>

  <h2 class="adm-h">Bildirilen rehberler</h2>
  <% if (!reported.length) { %>
    <p class="adm-empty">Bekleyen bildirim yok. Herkes rolünü düzgün oynuyor.</p>
  <% } %>
  <% reported.forEach(g => { %>
    <article class="case">
      <header class="case-head">
        <div>
          <a class="case-title" href="/rehber/<%= g.slug %>"><%= g.title %></a>
          <p class="case-meta">
            <span class="handle">@<%= g.username %></span>
            · <b><%= g.report_count %></b> bildirim
            <% if (g.hidden) { %>· <span class="flag">Gizlendi</span><% } %>
          </p>
        </div>
        <div class="case-actions">
          <form method="post" action="/yonetim/rehber/<%= g.id %>/temiz" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Sorun yok, yayında kalsın</button></form>
          <form method="post" action="/yonetim/rehber/<%= g.id %>/gizle" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Gizle</button></form>
          <form method="post" action="/yonetim/rehber/<%= g.id %>/sil" class="inline" onsubmit="return confirm('Rehber kalıcı olarak silinsin mi?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Sil</button></form>
          <% if (canBan(g)) { %>
            <form method="post" action="/yonetim/kullanici/<%= g.user_id %>/engelle" class="inline" onsubmit="return confirm('@<%= g.username %> engellensin mi? Tüm rehberleri gizlenir ve oturumu kapanır.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Yazarı engelle</button></form>
          <% } %>
        </div>
      </header>
      <ul class="case-reports">
        <% g.reports.forEach(r => { %>
          <li>
            <span class="case-reason"><%= REPORT_REASONS[r.reason] || r.reason %></span>
            <span class="case-by"><span class="handle">@<%= r.username %></span> · <%= formatDate(r.created_at) %></span>
            <% if (r.note) { %><q><%= r.note %></q><% } %>
          </li>
        <% }) %>
      </ul>
    </article>
  <% }) %>

  <h2 class="adm-h">Gizli rehberler</h2>
  <% if (!hidden.length) { %><p class="adm-empty">Gizlenmiş rehber yok.</p><% } %>
  <ul class="adm-list">
    <% hidden.forEach(g => { %>
      <li>
        <a href="/rehber/<%= g.slug %>"><%= g.title %></a> <span class="handle muted">@<%= g.username %></span>
        <span class="adm-list-actions">
          <form method="post" action="/yonetim/rehber/<%= g.id %>/temiz" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Yayına al</button></form>
          <form method="post" action="/yonetim/rehber/<%= g.id %>/sil" class="inline" onsubmit="return confirm('Rehber kalıcı olarak silinsin mi?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Sil</button></form>
        </span>
      </li>
    <% }) %>
  </ul>

  <h2 class="adm-h">Editörler</h2>
  <% if (!editors.length) { %><p class="adm-empty">Henüz editör yok. Vercel'de ADMIN_SIGNUP_CODE tanımlayıp kodu editörlerine ver; kodla üye olan editör olur.</p><% } %>
  <ul class="adm-list">
    <% editors.forEach(u => { %>
      <li>
        <b class="handle">@<%= u.username %></b> <span class="muted">· <%= formatDate(u.created_at) %></span>
        <% if (user.isSuper) { %>
          <span class="adm-list-actions">
            <form method="post" action="/yonetim/kullanici/<%= u.id %>/yetki-al" class="inline" onsubmit="return confirm('@<%= u.username %> artık editör olmasın mı?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Yetkiyi al</button></form>
          </span>
        <% } %>
      </li>
    <% }) %>
  </ul>

  <h2 class="adm-h">Engelli kullanıcılar</h2>
  <% if (!banned.length) { %><p class="adm-empty">Engelli kullanıcı yok.</p><% } %>
  <ul class="adm-list">
    <% banned.forEach(u => { %>
      <li>
        <b class="handle">@<%= u.username %></b>
        <span class="adm-list-actions">
          <form method="post" action="/yonetim/kullanici/<%= u.id %>/kaldir" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Engeli kaldır</button></form>
        </span>
      </li>
    <% }) %>
  </ul>
</section>
<%- include('partials/foot') %>
