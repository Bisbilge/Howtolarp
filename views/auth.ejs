<%- include('partials/head') %>
<section class="page page-auth">
  <aside class="page-side">
    <h1 class="page-h page-h-xl"><%- mode === 'kayit' ? 'Yeni bir<br><span class="hl">kimlik</span><br>oluştur' : 'Tekrar<br><span class="hl">sahneye</span>' %></h1>
  </aside>
  <div class="page-main">
    <p class="lede"><%= mode === 'kayit' ? 'Üye ol, kendi rehberlerini yaz, işe yarayanları larpla.' : 'Kaldığın rolden devam et.' %></p>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="post" action="/<%= mode %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="sonra" value="<%= sonra %>">
      <div class="hp" aria-hidden="true"><label>Web sitesi <input name="website" tabindex="-1" autocomplete="off"></label></div>
      <label class="f"><span class="f-l">Kullanıcı adı</span>
        <input class="f-big" name="username" required autocomplete="username" value="<%= username %>" <%- mode === 'kayit' ? 'pattern="[a-zA-Z0-9_.]{3,24}" title="3-24 karakter: harf, rakam, nokta, alt çizgi"' : '' %>>
      </label>
      <label class="f"><span class="f-l">Şifre <% if (mode === 'kayit') { %><em>en az 8 karakter</em><% } %></span>
        <input class="f-big" name="password" type="password" required <%- mode === 'kayit' ? 'minlength="8" autocomplete="new-password"' : 'autocomplete="current-password"' %>>
      </label>
      <% if (mode === 'kayit') { %>
        <label class="check"><input type="checkbox" name="kabul" value="1" required>
          <span><a href="/kurallar" target="_blank">Kuralları ve gizlilik metnini</a> okudum, kabul ediyorum.</span></label>
        <% if (adminCodeEnabled) { %>
        <details class="admin-code">
          <summary>Editör kodun var mı?</summary>
          <label class="f"><span class="f-l">Editör kodu <em>davet edildiysen</em></span><input name="admin_code" type="password" autocomplete="off"></label>
        </details>
        <% } %>
      <% } %>
      <% if (turnstileKey) { %>
        <div class="cf-turnstile" data-sitekey="<%= turnstileKey %>" data-language="tr"></div>
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      <% } %>
      <div class="f-actions">
        <button class="big-btn" type="submit"><%= mode === 'kayit' ? 'Üye ol →' : 'Giriş yap →' %></button>
        <% if (mode === 'kayit') { %>
          <a href="/giris?sonra=<%= encodeURIComponent(sonra) %>">Zaten üyeyim</a>
        <% } else if (signupsOpen) { %>
          <a href="/kayit?sonra=<%= encodeURIComponent(sonra) %>">Hesabım yok</a>
        <% } %>
      </div>
    </form>
  </div>
</section>
<%- include('partials/foot') %>
