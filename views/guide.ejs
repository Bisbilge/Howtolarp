<%- include('partials/head') %>
<% if (!guide.approved && !guide.banned) { %>
  <div class="notice" role="status">
    <% if (justSubmitted && isOwner) { %><b>Rehberin alındı!</b> Yöneticiler onaylayınca yayına girecek. Bu sırada sadece sen görebilirsin.
    <% } else if (isOwner && !user.isAdmin) { %><b>Onay bekliyor.</b> Yöneticiler onaylayınca yayına girecek.
    <% } else { %><b>Onay bekleyen rehber.</b> Henüz yayında değil.<% } %>
  </div>
<% } %>
<% if (guide.hidden || guide.banned) { %>
  <div class="notice notice-warn" role="status">
    <% if (guide.banned) { %><b>Yazarı engelli.</b> Bu rehber kimseye görünmüyor.
    <% } else if (isOwner && !user.isAdmin) { %><b>Bu rehber şu an yayında değil.</b> Bildirimler nedeniyle gizlendi; yöneticiler inceliyor.
    <% } else { %><b>Gizli rehber.</b> Sadece yazarı ve yöneticiler görebilir.<% } %>
  </div>
<% } %>
<% if (user && user.isAdmin) { %>
  <div class="adminbar">
    <span><b><%= user.isSuper ? 'Yönetici' : 'Editör' %></b> · <%= guideReports %> açık bildirim</span>
    <div>
      <% if (!guide.approved) { %>
        <form method="post" action="/yonetim/rehber/<%= guide.id %>/onayla" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="sonra" value="/rehber/<%= guide.slug %>"><button class="ok">Onayla</button></form>
      <% } %>
      <% if (guide.hidden) { %>
        <form method="post" action="/yonetim/rehber/<%= guide.id %>/temiz" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="sonra" value="/rehber/<%= guide.slug %>"><button>Yayına al</button></form>
      <% } else { %>
        <form method="post" action="/yonetim/rehber/<%= guide.id %>/gizle" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="sonra" value="/rehber/<%= guide.slug %>"><button>Gizle</button></form>
      <% } %>
      <form method="post" action="/yonetim/rehber/<%= guide.id %>/sil" class="inline" onsubmit="return confirm('Rehber kalıcı olarak silinsin mi?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Sil</button></form>
      <a href="/yonetim">Panele git →</a>
    </div>
  </div>
<% } %>
<article class="guide">
  <header class="g-head">
    <p class="crumbs"><a href="/">Endeks</a> / <a href="/?kategori=<%= encodeURIComponent(guide.category) %>#rehberler"><%= guide.category %></a> / Rehber #<%= String(guide.id).padStart(3, '0') %></p>
    <div class="g-head-grid">
      <div>
        <h1 class="g-title"><%= guide.title %></h1>
        <p class="g-sum"><%= guide.summary %></p>
        <div class="g-tools">
          <button type="button" class="ghost-btn" data-share data-title="<%= guide.title %>">Paylaş ↗</button>
          <a class="ghost-btn" href="/rastgele">Başka bir rol ↻</a>
        </div>
        <% if (isOwner) { %>
          <div class="owner">
            <a href="/rehber/<%= guide.slug %>/duzenle">Düzenle</a>
            <form method="post" action="/rehber/<%= guide.slug %>/sil" class="inline" onsubmit="return confirm('Bu rehber kalıcı olarak silinsin mi?')">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button type="submit">Sil</button>
            </form>
          </div>
        <% } %>
      </div>

      <div class="idcard" aria-label="Rol kartı">
        <div class="idcard-top"><span>Rol kartı</span><span>No. <%= String(guide.id).padStart(5, '0') %></span></div>
        <div class="idcard-body">
          <div class="idcard-photo" aria-hidden="true"><span>?</span></div>
          <dl>
            <dt>Rol</dt><dd class="idcard-role"><%= persona(guide.title) %></dd>
            <dt>Zorluk</dt><dd><%- include('partials/meter', { level: guide.difficulty }) %> <%= DIFFICULTY_LABELS[guide.difficulty] %></dd>
            <dt>Yazan</dt><dd class="handle">@<%= guide.username %></dd>
            <dt>Tarih</dt><dd><%= formatDate(guide.created_at) %></dd>
          </dl>
        </div>
        <div class="barcode" aria-hidden="true"></div>
        <div class="stamp <%= guide.approved ? '' : 'stamp-wait' %>" aria-hidden="true"><%- guide.approved ? 'Onaylı<br>larp' : 'Onay<br>bekliyor' %></div>
      </div>
    </div>
  </header>

  <div class="g-body">
    <% if (lines(guide.kit).length) { %>
      <section class="sec">
        <h2 class="sec-h"><span>A</span> Çantada olacaklar</h2>
        <ul class="kit">
          <% lines(guide.kit).forEach((l, i) => { %>
            <li><label><input type="checkbox"><span><%= l %></span></label></li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <section class="sec">
      <h2 class="sec-h"><span>B</span> Sahne talimatı</h2>
      <ol class="steps"><% lines(guide.steps).forEach((l, i) => { %><li><span class="step-no"><%= i + 1 %></span><p><%= l %></p></li><% }) %></ol>
    </section>

    <% if (lines(guide.phrases).length) { %>
      <section class="sec">
        <h2 class="sec-h"><span>C</span> Replikler <small>dokun, kopyala</small></h2>
        <div class="bubbles"><% lines(guide.phrases).forEach(l => { %><button type="button" class="bubble" data-copy title="Kopyalamak için dokun"><%= l.replace(/^["“”']+|["“”']+$/g, '') %></button><% }) %></div>
      </section>
    <% } %>

    <% if (lines(guide.risks).length) { %>
      <section class="sec sec-risk">
        <div class="tape" aria-hidden="true"><span>İfşa riski ✕ İfşa riski ✕ İfşa riski ✕ İfşa riski ✕ İfşa riski ✕ İfşa riski ✕ İfşa riski ✕ İfşa riski</span></div>
        <h2 class="sec-h"><span>D</span> Nerede yakalanırsın</h2>
        <ol class="risks"><% lines(guide.risks).forEach(l => { %><li><%= l %></li><% }) %></ol>
      </section>
    <% } %>
  </div>

  <div class="larp-box" id="larpladim">
    <div>
      <p class="larp-count"><%= guide.like_count %></p>
      <p class="larp-label">kişi bu rehberle larpladı</p>
    </div>
    <% if (!guide.hidden && !guide.banned && guide.approved) { %>
      <form method="post" action="/rehber/<%= guide.slug %>/larpladim">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="big-btn <%= liked ? 'is-on' : '' %>" type="submit"><%= liked ? '✓ Larpladım' : 'Ben de larpladım' %></button>
      </form>
    <% } %>
  </div>

  <% if (!isOwner && !guide.hidden && guide.approved && (user || signupsOpen)) { %>
  <section class="report" id="bildir">
    <% if (justReported || reported) { %>
      <p class="report-done">✕ Bu rehberi bildirdin. Yöneticiler inceleyecek, teşekkürler.</p>
    <% } else if (!user) { %>
      <p>Bu rehberde kurallara aykırı bir şey mi var? <a href="/giris?sonra=<%= encodeURIComponent('/rehber/' + guide.slug + '#bildir') %>">Giriş yapıp bildir</a></p>
    <% } else { %>
      <details>
        <summary>Bu rehberi bildir</summary>
        <form method="post" action="/rehber/<%= guide.slug %>/bildir" class="report-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <fieldset>
            <legend>Sorun ne?</legend>
            <% Object.entries(REPORT_REASONS).forEach(([k, v], i) => { %>
              <label class="radio"><input type="radio" name="reason" value="<%= k %>" <%= i === 0 ? 'required' : '' %>><span><%= v %></span></label>
            <% }) %>
          </fieldset>
          <label class="f"><span class="f-l">Not <em>isteğe bağlı</em></span>
            <textarea name="note" rows="2" maxlength="500" placeholder="Yöneticilere kısa bir açıklama"></textarea>
          </label>
          <div><button class="big-btn small" type="submit">Bildir</button></div>
        </form>
      </details>
    <% } %>
  </section>
  <% } %>

  <% if (more.length) { %>
    <section class="index more">
      <h2 class="index-title">Aynı kategoriden</h2>
      <ol class="rows"><% more.forEach((g, i) => { %><%- include('partials/row', { g, n: i + 1 }) %><% }) %></ol>
    </section>
  <% } %>
</article>
<div class="toast" role="status" aria-live="polite" hidden></div>
<script>
  (function () {
    var toast = document.querySelector('.toast'), t;
    function say(msg) {
      toast.textContent = msg; toast.hidden = false;
      clearTimeout(t); t = setTimeout(function () { toast.hidden = true; }, 1800);
    }
    function copy(text, msg) {
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () { say(msg); }, function () { say('Kopyalanamadı'); });
      else say('Kopyalanamadı');
    }
    document.querySelectorAll('[data-copy]').forEach(function (b) {
      b.addEventListener('click', function () { copy(b.textContent.trim(), 'Replik kopyalandı. Sahneye hazırsın.'); });
    });
    var share = document.querySelector('[data-share]');
    if (share) share.addEventListener('click', function () {
      var data = { title: share.dataset.title, url: location.href.split('?')[0].split('#')[0] };
      if (navigator.share) navigator.share(data).catch(function () {});
      else copy(data.url, 'Bağlantı kopyalandı.');
    });
  })();
</script>
<%- include('partials/foot') %>
