<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' / HOW TO LARP' : 'HOW TO LARP / Olma. Öyle görün.' %></title>
  <meta name="description" content="Zeki biri, startup kurucusu, kahve uzmanı... Olmadığın biri gibi nasıl davranılır? Üyelerin yazdığı larp rehberleri.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap">
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
<% if (ticker.length) { %>
<div class="ticker" aria-label="Son rehberler">
  <div class="ticker-track">
    <% for (let k = 0; k < 2; k++) { %>
      <div class="ticker-group" <%- k ? 'aria-hidden="true"' : '' %>>
        <span class="ticker-label">ŞU AN LARPLANIYOR</span>
        <% ticker.forEach(t => { %><a href="/rehber/<%= t.slug %>" <%- k ? 'tabindex="-1"' : '' %>><%= persona(t.title) %></a><span class="ticker-sep">✕</span><% }) %>
      </div>
    <% } %>
  </div>
</div>
<% } %>
<header class="masthead">
  <a class="wordmark" href="/" aria-label="How to LARP ana sayfa">HOW TO <span>LARP</span></a>
  <nav class="nav">
    <a href="/hakkinda" class="<%= path === '/hakkinda' ? 'on' : '' %>">Larp ne?</a>
    <% if (user) { %>
      <a href="/u/<%= encodeURIComponent(user.username) %>" class="<%= path.toLowerCase() === ('/u/' + user.username).toLowerCase() ? 'on' : '' %>"><span class="handle">@<%= user.username %></span></a>
      <form method="post" action="/cikis" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="nav-btn">Çık</button>
      </form>
      <a href="/yaz" class="nav-cta">+ Rehber yaz</a>
    <% } else { %>
      <a href="/giris" class="<%= path === '/giris' ? 'on' : '' %>">Giriş</a>
      <a href="/kayit" class="nav-cta">Üye ol</a>
    <% } %>
  </nav>
</header>
<main>
