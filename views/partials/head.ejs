<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' · How to LARP' : 'How to LARP: Olmadığın biri gibi davranmanın rehberleri' %></title>
<% const metaTitle = title ? title + ' · How to LARP' : 'How to LARP: Olmadığın biri gibi davranmanın rehberleri';
   const metaDesc = description || 'Zeki biri, startup kurucusu, kahve uzmanı… Olmadığın biri gibi nasıl davranılır? Adım adım larp rehberleri: hazırlık, replikler ve nerede yakalanırsın.'; %>
  <meta name="description" content="<%= metaDesc %>">
  <link rel="canonical" href="<%= canonical || (baseUrl + path) %>">
  <% if (noindex) { %><meta name="robots" content="noindex, follow"><% } %>
  <meta property="og:site_name" content="How to LARP">
  <meta property="og:type" content="<%= ogType %>">
  <meta property="og:title" content="<%= metaTitle %>">
  <meta property="og:description" content="<%= metaDesc %>">
  <meta property="og:url" content="<%= canonical || (baseUrl + path) %>">
  <meta property="og:image" content="<%= ogImage || (baseUrl + '/og.png') %>">
  <meta name="twitter:image" content="<%= ogImage || (baseUrl + '/og.png') %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="tr_TR">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#c8ff1a">
  <% if (jsonLd) { %><script type="application/ld+json"><%- jsonLd %></script><% } %>
  <link rel="preload" href="/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <% if (analytics) { %>
  <!-- Vercel Web Analytics: çerezsiz, kimliksiz ziyaret sayımı -->
  <script>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
  <script defer src="/_vercel/insights/script.js"></script>
  <% } %>
</head>
<body>
<a class="skip" href="#icerik">İçeriğe geç</a>
<% if (ticker.length) { %>
<div class="ticker" aria-label="Son rehberler">
  <div class="ticker-track">
    <% for (let k = 0; k < 2; k++) { %>
      <div class="ticker-group" <%- k ? 'aria-hidden="true"' : '' %>>
        <span class="ticker-label">ŞU AN LARPLANIYOR</span>
        <% ticker.forEach(t => { %><a href="/rehber/<%= t.slug %>" <%- k ? 'tabindex="-1"' : '' %>><%= persona(t.title) %></a><span class="ticker-sep">✕</span><% }) %>
      </div>
    <% } %>
  </div>
</div>
<% } %>
<header class="masthead">
  <a class="wordmark" href="/" aria-label="How to LARP ana sayfa">HOW TO <span>LARP</span></a>
  <nav class="nav">
    <a href="/test" class="<%= path.startsWith('/test') ? 'on' : '' %>">Hangi larpsın?</a>
    <a href="/rastgele" title="Rastgele bir rehber aç">Rastgele</a>
    <a href="/larp-ne-demek" class="<%= path === '/larp-ne-demek' ? 'on' : '' %>">Larp ne demek?</a>
    <% if (user) { %>
      <% if (user.isAdmin) { %>
        <a href="/yonetim" class="<%= path === '/yonetim' ? 'on' : '' %>">Yönetim<% if (openReports) { %> <span class="badge"><%= openReports %></span><% } %></a>
      <% } %>
      <a href="/rehberlerim" class="<%= path === '/rehberlerim' ? 'on' : '' %>" title="Giriş yapan: @<%= user.username %>">Rehberlerim</a>
      <form method="post" action="/cikis" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="nav-btn">Çık</button>
      </form>
      <a href="/yaz" class="nav-cta">+ Rehber yaz</a>
    <% } else { %>
      <% if (signupsOpen) { %>
        <a href="/giris" class="<%= path === '/giris' ? 'on' : '' %>">Giriş</a>
        <a href="/kayit" class="nav-cta">Üye ol</a>
      <% } %>
    <% } %>
  </nav>
</header>
<main id="icerik">
