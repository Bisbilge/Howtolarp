<a class="card" href="/rehber/<%= g.slug %>">
  <div class="card-top">
    <span class="tag"><%= g.category %></span>
    <span class="dots" title="Larp zorluğu: <%= DIFFICULTY_LABELS[g.difficulty] %>" aria-label="Zorluk <%= g.difficulty %>/5">
      <% for (let i = 1; i <= 5; i++) { %><i class="<%= i <= g.difficulty ? 'on' : '' %>"></i><% } %>
    </span>
  </div>
  <h3 class="card-title"><%= g.title %></h3>
  <p class="card-summary"><%= g.summary %></p>
  <div class="card-meta">
    <span>@<%= g.username %></span>
    <span><%= g.like_count %> kişi larpladı</span>
  </div>
</a>
