<%- include('partials/head') %>
<% if (justReported) { %>
  <div class="notice" role="status"><b>Bildirimin alındı.</b> Rehber, yöneticiler inceleyene kadar yayından kaldırıldı.</div>
<% } %>
<% const listUrl = (o) => { const p = new URLSearchParams(Object.fromEntries(Object.entries(o).filter(([k, v]) => v && !(k === 'sirala' && v === 'yeni') && !(k === 'sayfa' && v === 1)))).toString(); return (o.path || listPath) + (p ? '?' + p : ''); }; %>
<% if (kategori) { %>
<section class="cat-head">
  <p class="crumbs"><a href="/">Endeks</a> / Kategori</p>
  <h1 class="page-h page-h-xl"><%= kategori %></h1>
  <p class="lede"><%= CATEGORY_INFO[kategori].intro %></p>
</section>
<% } else { %>
<section class="hero">
  <div class="hero-text">
    <p class="kicker">Sayı <%= String(stats.guides).padStart(3, '0') %> · <%= stats.users %> larpçı · Ücretsiz, tabii ki</p>
    <h1 class="hero-h">
      <span class="hero-persona" data-personas="<%= JSON.stringify(personas) %>"><%- personas[0] || 'Zeki biri' %></span>
      <span class="hero-line"><s>olma.</s> <mark>öyle görün.</mark></span>
    </h1>
    <p class="hero-sub">Hiç okumadığın kitabı okumuş, hiç kurmadığın şirketi kurmuş gibi davranmanın halk ansiklopedisi. <%= signupsOpen ? 'Rehberleri üyeler yazıyor. Sıra sende.' : 'Bir rol seç, hazırlığını yap, sahneye çık.' %></p>
    <div class="hero-actions">
      <% if (user) { %><a class="big-btn" href="/yaz">Rehberini yaz →</a>
      <% } else if (signupsOpen) { %><a class="big-btn" href="/kayit">Rehberini yaz →</a>
      <% } else { %><a class="big-btn" href="#rehberler">Rehberlere göz at ↓</a><% } %>
      <a class="ghost-btn" href="/test">Hangi larpsın? Teste gir →</a>
      <a class="ghost-btn" href="/rastgele">Bana rastgele bir rol ver ↻</a>
    </div>
  </div>
  <div class="sticker" aria-hidden="true">
    <svg viewBox="0 0 200 200">
      <defs><path id="circ" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
      <circle cx="100" cy="100" r="98" class="sticker-bg"/>
      <g class="spin"><text><textPath href="#circ" textLength="486" lengthAdjust="spacing">%100 SAHTE ✕ %100 İKNA EDİCİ ✕ %100 SAHTE ✕ %100 İKNA EDİCİ ✕</textPath></text></g>
      <text x="100" y="98" text-anchor="middle" class="sticker-big"><%= stats.guides %></text>
      <text x="100" y="124" text-anchor="middle" class="sticker-small">REHBER</text>
    </svg>
  </div>
</section>

<% } %>
<% if (!kategori && requested && requested.length) { %>
<section class="req-strip">
  <span class="req-strip-h">En çok istenenler</span>
  <% requested.forEach(r => { %><a href="/istekler#istek-<%= r.id %>"><%- markEn(r.text) %> <b>▲<%= r.votes %></b></a><% }) %>
  <a class="req-strip-all" href="/istekler">Tümü · Öner →</a>
</section>
<% } else if (!kategori) { %>
<section class="req-strip"><span class="req-strip-h">Bir rolün rehberi mi yok?</span><a class="req-strip-all" href="/istekler">İstek yap →</a></section>
<% } %>
<section class="index" id="rehberler">
  <div class="index-head">
    <h2 class="index-title"><%= kategori ? 'Bu kategorideki rehberler' : 'Rehber endeksi' %></h2>
    <form class="search" method="get" action="<%= listPath %>#rehberler">
      <input type="search" name="q" value="<%= q %>" placeholder="Ne larplıyoruz bugün?" aria-label="Rehberlerde ara">
      <% if (sirala !== 'yeni') { %><input type="hidden" name="sirala" value="<%= sirala %>"><% } %>
      <button type="submit">Ara</button>
    </form>
  </div>
  <div class="filters">
    <div class="cats">
      <a class="<%= !kategori ? 'on' : '' %>" href="<%= listUrl({ path: '/', q, sirala }) %>#rehberler">Hepsi</a>
      <% CATEGORIES.forEach(c => { %><a class="<%= kategori === c ? 'on' : '' %>" href="<%= listUrl({ path: '/kategori/' + CATEGORY_INFO[c].slug, q, sirala }) %>#rehberler"><%= c %></a><% }) %>
    </div>
    <div class="sort">
      <a class="<%= sirala === 'yeni' ? 'on' : '' %>" href="<%= listUrl({ q, sirala: 'yeni' }) %>#rehberler">Yeni</a>
      <a class="<%= sirala === 'populer' ? 'on' : '' %>" href="<%= listUrl({ q, sirala: 'populer' }) %>#rehberler">Çok larplanan</a>
    </div>
  </div>

  <% if (guides.length) { %>
    <ol class="rows"><% guides.forEach((g, i) => { %><%- include('partials/row', { g, n: offset + i + 1 }) %><% }) %></ol>
    <% if (sayfa > 1 || hasMore) { %>
      <nav class="pager" aria-label="Sayfalar">
        <% if (sayfa > 1) { %><a href="<%= listUrl({ q, sirala, sayfa: sayfa - 1 }) %>#rehberler">← Önceki</a><% } else { %><span></span><% } %>
        <span class="pager-no">Sayfa <%= sayfa %></span>
        <% if (hasMore) { %><a href="<%= listUrl({ q, sirala, sayfa: sayfa + 1 }) %>#rehberler">Sonraki →</a><% } else { %><span></span><% } %>
      </nav>
    <% } %>
  <% } else { %>
    <div class="void">
      <p class="void-big">Burada kimse yok.</p>
      <p>Bu larpın rehberi henüz yazılmamış. Demek ki uzmanı sensin.</p>
      <% if (user || signupsOpen) { %><a class="big-btn" href="<%= user ? '/yaz' : '/kayit' %>">İlk rehberi yaz →</a>
      <% } else { %><a class="big-btn" href="/">Tüm rehberler →</a><% } %>
    </div>
  <% } %>
</section>
<script>
  (function () {
    var el = document.querySelector('.hero-persona');
    if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var list = JSON.parse(el.dataset.personas || '[]'), i = 0;
    if (list.length < 2) return;
    setInterval(function () {
      el.classList.add('flip');
      setTimeout(function () { i = (i + 1) % list.length; el.innerHTML = list[i]; el.classList.remove('flip'); }, 180);
    }, 2400);
  })();
</script>
<%- include('partials/foot') %>
